## Used by aihwkit.

# Temporary folders from the build system.
_skbuild

# Folder for Sphinx output.
docs/build

# Compiled files.
src/aihwkit/simulator/*.so

# Temporary folder for the example downloads.
data/

# Folder for cibuildwheel.
wheelhouse/

## From https://github.com/github/gitignore/blob/master/Python.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

## Additional convenience ignores. https://git-scm.com/docs/gitignore#_configuration

# Editors
*flymake.py
.vscode
\#*\#
.\#*
*~

# Large files - model weights and experiment logs
*.pth
wandb/
examples/wandb/
examples/results/*
!examples/results/*/
!examples/results/**/*.db

# Checkpoint files
*.ckpt
*.pt
ckpt/
checkpoints/

# Excel and data files
*.xlsx
*.xls
*.csv

# Test outputs and results
*_RESULTS/
*.log
*.bak

# Run-output artifacts (BERT/MobileBERT/ALBERT/MLP fine examples)
**/_tmp_*.py
**/_tmp_smoke_*.py
**/runlog_*.txt
**/squad_diagnostic_log_*.json
examples/bert/results/BERT_SQUAD_LRTT_FINE/squad_*.png
examples/bert/results/BERT_SQUAD_LRTT_FINE/squad_*.svg
examples/bert/results/MOBILEBERT_SQUAD_LRTT_FINE/squad_*.png
examples/bert/results/MOBILEBERT_SQUAD_LRTT_FINE/squad_*.svg
examples/bert/results/ALBERT_SQUAD_LRTT_FINE/squad_*.png

# Large per-experiment raw diagnostic JSONs (keep summary_*.json, .md, plots)
examples/bert/results/plots/diag_*/diag_*.json
examples/bert/results/plots/diag_*/multi_logs.json

# CUDA installer detritus
cuda-keyring_*.deb*

# Optuna zombie-cleanup locks
**/_zombie_cleanup_*.lock

# New plots/analysis/ structure (post-reorganization 6/14)
examples/bert/results/plots/analysis/*/diag_*.json
examples/bert/results/plots/analysis/*/diag_collapse_*.json
